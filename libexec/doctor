#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${EUID}" -ne 0 ]]; then
    echo "kilnr doctor: must run as root" >&2
    exit 1
fi

failed=0

check() {
    local label="$1"
    shift

    if "$@" >/dev/null 2>&1; then
        printf '✓ %s\n' "$label"
    else
        printf '✗ %s\n' "$label"
        failed=1
    fi
}

for command in \
    git \
    make \
    docker \
    setfacl \
    iptables
do
    check \
        "command ${command}" \
        sh -c "command -v '${command}'"
done

for user in \
    git \
    kilnr \
    kilnr-web
do
    check \
        "user ${user}" \
        getent passwd "$user"
done

for group in \
    kilnr-submit \
    kilnr-readers
do
    check \
        "group ${group}" \
        getent group "$group"
done

for path in \
    /srv/git \
    /var/lib/kilnr/queue/incoming \
    /var/lib/kilnr/queue/running \
    /var/lib/kilnr/builds \
    /var/lib/kilnr/secret-staging \
    /var/lib/kilnr/job-runtime \
    /etc/kilnr/projects \
    /etc/kilnr/secrets \
    /usr/local/libexec/kilnr/controller
do
    check \
        "$path" \
        test -e "$path"
done

check \
    "kilnr-queue.path active" \
    systemctl is-active --quiet kilnr-queue.path

check \
    "kilnr-network.service active" \
    systemctl is-active --quiet kilnr-network.service

check \
    "Docker network kilnr-ci" \
    docker network inspect kilnr-ci

check \
    "Kilnr controller executable" \
    test -x /usr/local/libexec/kilnr/controller

check \
    "Kilnr execute executable" \
    test -x /usr/local/libexec/kilnr/execute

check \
    "Kilnr enqueue executable" \
    test -x /usr/local/libexec/kilnr/enqueue

for helper in secret-set secret-set-file secret-list secret-delete; do
    check \
        "Kilnr ${helper} executable" \
        test -x "/usr/local/libexec/kilnr/${helper}"
done

exit "$failed"
